# Copy to .env and edit. Every setting is optional.

# ---- AI review (optional) -------------------------------------------------------------
# After stems and chords are detected, an LLM driven by the Cteno Agent SDK proofreads the
# chart (spelling, one-beat blips, sections, capo, easy chords, strum pattern, lyric lines).
# It cannot hear the audio; it only reasons over the detected data. Leave the key empty to skip.
# Any OpenAI-, Anthropic- or Gemini-compatible endpoint works. Example: DeepSeek.
DEEPSEEK_API_KEY=
JAM_AI_BASE_URL=https://api.deepseek.com/v1
JAM_AI_MODEL=deepseek-chat
JAM_AI_API_FORMAT=openai
# JAM_AI_API_KEY=            # use this instead of DEEPSEEK_API_KEY for other providers
# JAM_AI_REVIEW=1            # 0 disables the review even when a key is set
# JAM_AI_TIMEOUT_S=300

# ---- Server ---------------------------------------------------------------------------
# JAM_PORT=8765
# JAM_MODE=full              # full = upload + processing; player = playback/sync only
# JAM_ADMIN_KEY=             # passphrase required to upload / edit / delete (recommended when public)
# JAM_PUBLIC_URL=            # e.g. https://jam.example.com — used in share links and QR codes
# JAM_MAX_UPLOAD_MB=200
# JAM_MAX_DURATION_S=900
# Abuse guards for an internet-facing instance without a passphrase (0 = off):
# JAM_MAX_QUEUE=0            # songs waiting+processing; above it uploads get 429 "queue full"
# JAM_UPLOADS_PER_IP_HOUR=0  # per client IP (X-Forwarded-For); LAN addresses are exempt
# JAM_RATE_LIMIT_PRIVATE=0   # 1 = rate-limit LAN addresses too
# JAM_MAX_DISK_PERCENT=0     # refuse uploads when the data disk is fuller than this

# ---- Jamendo free music (optional) ----------------------------------------------------
# Lets people search https://www.jamendo.com (Creative Commons music), preview tracks and add one as a
# song. Only tracks whose artists allow downloads are shown; the license is kept with the song.
# Get a free client id at https://devportal.jamendo.com. It stays on the server; empty hides the button.
# JAM_JAMENDO_CLIENT_ID=
# JAM_JAMENDO_API_URL=https://api.jamendo.com/v3.0

# ---- Processing -----------------------------------------------------------------------
# JAM_DEVICE=auto            # auto | cpu | cuda
# JAM_THREADS=0              # CPU threads for separation (0 = PyTorch default)
# JAM_WORKERS=1              # songs processed at the same time
# JAM_DEMUCS_MODEL=htdemucs_6s
# JAM_WHISPER_MODEL=small    # tiny | base | small | medium | off
# JAM_LRCLIB=1               # look up synced lyrics on lrclib.net first (sends title/artist)
# HF_ENDPOINT=               # Hugging Face mirror for Whisper weights, if needed
# JAM_SEED_DEMO=1            # add the bundled CC0 demo songs on first start
