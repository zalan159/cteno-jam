# Test-machine settings for scripts/e2e_all.sh (copy to .env.test, which is git-ignored, then
#   set -a; . ./.env.test; set +a; scripts/e2e_all.sh)
# ssh host (from ~/.ssh/config) that runs the dev server, and its LAN address seen from the Mac
JAM_SERVER_HOST=
JAM_SERVER_IP=
# ssh host of the Mac with Playwright browsers and Xcode simulators, and the work dir there
JAM_MAC_HOST=
JAM_MAC_ROOT=CtenoDev/jam
